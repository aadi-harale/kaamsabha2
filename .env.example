# Optional Supabase integration placeholders. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Server-only OTP signing secret used by /api/otp.
KAAMSABHA_OTP_SECRET=replace_with_a_long_random_server_secret

# Judge/demo mode only: returns the generated OTP to the customer UI so the cross-role flow is self-contained.
# Keep false/omit in a real deployment where OTP is delivered out-of-band.
KAAMSABHA_DEMO_MODE=true
KAAMSABHA_DATA_MODE=demo

# Optional intake AI. AI is intake-only and never dispatches, prices, penalizes, replays or activates policy.
OPENROUTER_API_KEY=your_server_only_openrouter_key
