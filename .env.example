# Optional Supabase mirror. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# Keep false for the reliable device-local judge demo. Set true only after applying supabase/001_kaamsabha_state.sql.
NEXT_PUBLIC_KAAMSABHA_REMOTE_SYNC=false

# Server-only OTP signing secret used by /api/otp.
KAAMSABHA_OTP_SECRET=replace_with_a_long_random_server_secret

# Judge/demo mode only: returns generated OTP to the customer UI for the cross-role walkthrough.
KAAMSABHA_DEMO_MODE=true
KAAMSABHA_DATA_MODE=demo

# Optional intake AI. Server-only. AI only structures customer intake; it never dispatches, prices, penalizes, replays or activates policy.
OPENROUTER_API_KEY=your_server_only_openrouter_key
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional routing endpoint. Public OSRM is used by default and has a deterministic direct-distance fallback.
OSRM_BASE_URL=https://router.project-osrm.org
