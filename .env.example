# Optional Supabase mirror. Never commit real credentials.
# Read PRODUCTION_READINESS.md before enabling any of this.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
# This key bypasses row-level security. It is server-only and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# Keep false for the reliable device-local judge demo. Set true only after applying supabase/001_kaamsabha_state.sql.
NEXT_PUBLIC_KAAMSABHA_REMOTE_SYNC=false

# DANGEROUS. The mirror is written to by the browser, which holds no credential, so every write
# arriving at the server is anonymous and is stored with the service-role key above. Turning
# this on means anyone who finds the URL can replace the whole cooperative register. It is off
# by default and /api/state returns 403 until it is set to exactly "true". Use it only for a
# throwaway demo workspace you are willing to let strangers overwrite.
KAAMSABHA_ALLOW_ANONYMOUS_STATE_WRITES=false
# The single workspace this deployment will mirror. Writes to any other name are refused.
KAAMSABHA_SYNC_WORKSPACE=shared-demo

# Server-only OTP signing secret used by /api/otp.
KAAMSABHA_OTP_SECRET=replace_with_a_long_random_server_secret

# Judge/demo mode only: returns generated OTP to the customer UI for the cross-role walkthrough.
KAAMSABHA_DEMO_MODE=true
KAAMSABHA_DATA_MODE=demo

# Optional OpenRouter AI, server-only. /api/ai/intake structures customer intake and /api/ai/policy clusters anonymized worker issues/suggestions for admin review.
# Neither route may dispatch, rank workers, set pay, penalize/deactivate, vote, decide challenges, or activate policy.
OPENROUTER_API_KEY=your_server_only_openrouter_key
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional routing endpoint. Public OSRM is used by default and has a deterministic direct-distance fallback.
OSRM_BASE_URL=https://router.project-osrm.org
