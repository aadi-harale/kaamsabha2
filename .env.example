# Public client values (safe to expose only when using Supabase publishable/anon keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only values. Configure in Vercel Project Settings; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
OPENROUTER_API_KEY=your_server_only_openrouter_key
OTP_SERVER_SECRET=replace_with_a_long_random_server_secret

# Optional demo/runtime controls
KAAMSABHA_DATA_MODE=demo
